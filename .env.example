# Mail Calendar Bridge 配置
# 复制此文件为 .env 并填入真实值

# ===== 邮件配置 (USTC 邮箱) =====
MAIL_HOST=mail.ustc.edu.cn
MAIL_PORT=993
MAIL_USERNAME=your_username@mail.ustc.edu.cn
MAIL_PASSWORD=your_password
MAIL_FOLDER=INBOX
MAIL_SEARCH_DAYS=7

# ===== Anthropic Claude API (支持第三方兼容 API) =====
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxx
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-6

# ===== DDL 提取参数 =====
DDL_CONFIDENCE_THRESHOLD=0.6

# ===== 输出配置 =====
OUTPUT_DIR=./output
OUTPUT_FILENAME=ddl_events_{date}.ics

# ===== 数据库配置 =====
DB_PATH=./data/mail_cache.db

# ===== 日志 =====
LOG_LEVEL=INFO